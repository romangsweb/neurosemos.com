+// Parche Neurosemos: Cloudflare Workers solo permite PBKDF2 nativo hasta 100 000 iteraciones,
+// y Payload usa 600 000. Si el nativo lo rechaza, se calcula lo mismo en JS puro (@noble/hashes).
+import crypto from 'crypto';
+import { pbkdf2Async } from '@noble/hashes/pbkdf2';
+import { sha256 } from '@noble/hashes/sha2';
+export const pbkdf2Compat = (password, salt, iterations, keyLength, callback)=>{
+    const fallback = ()=>pbkdf2Async(sha256, password, salt, {
+            c: iterations,
+            dkLen: keyLength
+        }).then((out)=>callback(null, Buffer.from(out)), (err)=>callback(err));
+    try {
+        crypto.pbkdf2(password, salt, iterations, keyLength, 'sha256', (err, hash)=>{
+            if (err) return fallback();
+            callback(null, hash);
+        });
+    } catch  {
+        fallback();
+    }
+};
